{
  "expo": {
    "name": "Immersed.",
    "slug": "immersed",
    "version": "0.21.6",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "scheme": "immersed-store",
    "icon": "../../assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.somamill.immersed",
      "appleTeamId": "YJH8WWUVF3",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIFileSharingEnabled": false,
        "CFBundleName": "Immersed."
      },
      "buildNumber": "16"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-video",
      "expo-asset"
    ],
    "updates": {
      "enabled": false
    },
    "extra": {
      "edition": "store"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
