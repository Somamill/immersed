{
  "name": "immersed",
  "version": "0.9.1",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.14",
    "expo-glass-effect": "~58.0.5",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "kuromoji": "^0.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.64.1",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "export:web": "expo export --platform web",
    "lint": "expo lint",
    "testflight": "npx eas-cli@latest build --platform ios --profile production --auto-submit",
    "language:setup": "node scripts/setup-dictionary.cjs",
    "test:language": "node --test tests/language.test.cjs",
    "version:update": "node scripts/version-update.cjs",
    "version:check": "node scripts/check-version.cjs",
    "test:server": "node --test tests/transcription.test.cjs tests/caption-features.test.cjs tests/hosted.test.cjs",
    "context:setup": "node scripts/setup-context.cjs",
    "context:evaluate": "node scripts/evaluate-context.cjs",
    "preview": "node scripts/start-preview.cjs",
    "build:hosted": "node scripts/build-hosted.cjs",
    "start:hosted": "node server/hosted.cjs",
    "mac:serve": "node desktop/server.cjs",
    "alignment:setup": "node scripts/setup-alignment.cjs",
    "test:mac": "node --test tests/mac-media.test.cjs tests/mac-server.test.cjs tests/highlighting.test.cjs && python3 -m unittest tests/test_mac_quality.py tests/test_mac_transcribe.py && playwright test --config playwright.mac.config.ts"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
