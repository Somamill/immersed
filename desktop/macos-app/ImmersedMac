#!/bin/sh
set -eu

url="http://127.0.0.1:4765/"
if /usr/bin/curl --silent --fail --max-time 1 "$url" >/dev/null 2>&1; then
  if [ -d "/Applications/Google Chrome.app" ]; then
    /usr/bin/open -a 'Google Chrome' --args --app="$url"
  else
    /usr/bin/open "$url"
  fi
  exit 0
fi

for launcher in /opt/homebrew/bin/immersed-mac /usr/local/bin/immersed-mac; do
  if [ -x "$launcher" ]; then
    exec "$launcher"
  fi
done

/usr/bin/osascript -e 'display alert "Immersed Mac is not installed" message "Install it with: brew install --HEAD Somamill/immersed/immersed-mac"'
exit 1
