{
  "expo": {
    "name": "Immersed",
    "slug": "immersed",
    "version": "0.16.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.somamill.immersed",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Immersed creates Japanese captions from the video audio on this iPhone while you watch. Audio is not saved or uploaded."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "immersed",
    "extra": {
      "storageScopeKey": "@anonymous/immersed-6848fb61-7eac-408c-9365-26aaec27faeb",
      "eas": {
        "projectId": "f6597504-4823-4dd7-99a1-32907814ea98"
      }
    },
    "owner": "somamill"
  }
}
